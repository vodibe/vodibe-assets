{
   "action": {
      "default_icon": {
         "16": "assets/nekoicon16.png",
         "48": "assets/nekoicon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "__MSG_appName__"
   },
   "browser_specific_settings": {
      "gecko": {
         "data_collection_permissions": {
            "optional": [  ],
            "required": [ "none" ]
         },
         "id": "cat-gatekeeper@nagomi.designer",
         "strict_min_version": "142.0"
      }
   },
   "content_scripts": [ {
      "css": [ "content.css" ],
      "js": [ "shared.js", "content.js" ],
      "matches": [ "http://*/*", "https://*/*" ]
   } ],
   "default_locale": "en",
   "description": "__MSG_appDescription__",
   "icons": {
      "128": "assets/nekoicon128.png",
      "16": "assets/nekoicon16.png",
      "48": "assets/nekoicon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.6",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "assets/*" ]
   } ]
}
